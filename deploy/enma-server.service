# systemd --user unit for enma-server (mcpbox meisei decisions tool).
# Independent deploy unit: updating enma rebuilds/redeploys ONLY this service,
# never the mcpbox platform or daruma.
#
# Install: copy the built binary to ~/.local/bin/enma-server, drop this file at
# ~/.config/systemd/user/enma-server.service, put ENMA_PLATFORM_SECRET (the
# platform-shared key) in ~/.config/enma/enma.env, then:
#   systemctl --user daemon-reload && systemctl --user enable --now enma-server
# Front it with nginx `enma.mcpbox.ru -> 127.0.0.1:$ENMA_PORT` and upsert the
# tool_registry row on the platform.

[Unit]
Description=enma-server (mcpbox meisei decisions tool)
After=network-online.target

[Service]
Environment=ENMA_PORT=8092
Environment=ENMA_VERSION=0.1.0
# Persistent object/event store; create %h/.local/share/enma before first start.
Environment=ENMA_DB=%h/.local/share/enma/enma.db
# ENMA_PLATFORM_SECRET (and any future keys) live here, NOT in this unit:
# OPENAI_API_KEY[/OPENAI_BASE_URL/OPENAI_MODEL] also goes there — without it
# the AI method `enma.decide` answers ai_not_configured (503).
EnvironmentFile=-%h/.config/enma/enma.env
ExecStartPre=/usr/bin/mkdir -p %h/.local/share/enma
ExecStart=%h/.local/bin/enma-server
Restart=always
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=default.target
